/node_modules/
/dist/
/test-app/
/tmp/

# Env files anywhere in the repo, including inside templates/. The template
# ships its local defaults as `_env.local` (renamed to .env.local on copy) so
# a real .env* can never be committed; .env.example is the documented exception.
.env
.env.*
!.env.example

**/.DS_Store

# Development artefacts inside the template directory. The template has no
# .gitignore of its own (npm would rename it to .npmignore in the tarball), so
# its ignores live here. Keep this list in sync with `ignorePatterns` in
# templates/*/.mouldconfig.json and the negated `files` entries in package.json.
/templates/*/node_modules/
/templates/*/.next/
/templates/*/next-env.d.ts
/templates/*/bun.lock
/templates/*/*.tsbuildinfo
/templates/*/dist/
/templates/*/postgres-data/
/templates/*/src/app/(client)/auth/
/templates/*/skills-lock.json
/templates/*/.claude/skills/database-migrations/
/templates/*/.claude/settings.local.json
