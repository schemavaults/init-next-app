{
  "name": "@schemavaults/init-next-app",
  "version": "0.1.0",
  "type": "module",
  "module": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schemavaults/init-next-app.git"
  },
  "bin": {
    "init-next-app": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "!templates/*/node_modules",
    "!templates/*/.next",
    "!templates/*/dist",
    "!templates/*/bun.lock",
    "!templates/*/next-env.d.ts",
    "!templates/*/*.tsbuildinfo",
    "!templates/*/src/app/(client)/auth",
    "!templates/*/postgres-data",
    "!templates/**/.env",
    "!templates/**/.env.*",
    "templates/*/.env.example",
    "!templates/*/skills-lock.json",
    "!templates/*/.claude/skills/database-migrations",
    "!templates/*/.claude/settings.local.json"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --banner '#!/usr/bin/env node'",
    "dev": "bun build src/index.ts --outdir dist --target node --format esm --banner '#!/usr/bin/env node' --watch",
    "test": "bash ./scripts/test.sh",
    "typecheck": "tsc --noEmit",
    "test:template": "bash ./scripts/test-template.sh"
  },
  "devDependencies": {
    "bun-types": "1.4.2",
    "typescript": "5.9.3"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@jalexw/mould": "0.7.1",
    "@schemavaults/app-definitions": "0.12.1",
    "commander": "14.0.3",
    "zod": "4.4.3"
  },
  "packageManager": "bun@1.4.2"
}
