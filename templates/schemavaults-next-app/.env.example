# .env.example - Environment variables required

# SchemaVaults Auth/Apps Configuration
SCHEMAVAULTS_CLIENT_APP_ID="00000000-0000-0000-0000-000000000000"
SCHEMAVAULTS_API_SERVER_ID="00000000-0000-0000-0000-000000000000"
SCHEMAVAULTS_AUTH_SERVER_URL="https://auth.schemavaults.com"
SCHEMAVAULTS_APP_ENVIRONMENT="production"
SCHEMAVAULTS_AUTH_JWKS_ACCESS_PRIVATE_KEY=""

# Database Credentials
POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_USER=""
POSTGRES_HOST=""
POSTGRES_PASSWORD=""
POSTGRES_DATABASE=""

# Theme (optional): override @schemavaults/theme tokens for this deployment.
# THEME_LIGHT_<TOKEN> / THEME_DARK_<TOKEN> set a token in one mode, THEME_RADIUS
# is shared by both; unset tokens keep the defaults. See "Theme" in README.md.
# THEME_LIGHT_PRIMARY="#2563eb"
# THEME_DARK_PRIMARY="#3b82f6"
# THEME_RADIUS="0.75rem"

# mould:if blob_storage == s3
# Blob Storage (AWS S3 or any S3-compatible provider)
# S3_ENDPOINT: leave empty for AWS S3; set to the provider's URL otherwise
# (e.g. https://<account-id>.r2.cloudflarestorage.com for Cloudflare R2)
# S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY: leave both empty to use the AWS SDK's
# default credential chain (e.g. an IAM role)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_FORCE_PATH_STYLE="false"

# mould:endif
# mould:if deployment == vercel
# Vercel Deployment Configuration
VERCEL_PROJECT_ID=""
VERCEL_ORG_ID=""
VERCEL_TOKEN=""
# mould:endif
