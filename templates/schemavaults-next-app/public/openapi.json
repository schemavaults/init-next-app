{
  "openapi": "3.1.0",
  "info": {
    "title": "xxx_display_name_xxx",
    "description": "xxx_description_xxx",
    "version": "0.0.1"
  },
  "servers": [
    {
      "url": "/",
      "description": "The origin this document was served from"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Health and diagnostics."
    },
    {
      "name": "Account",
      "description": "The authenticated user."
    },
    {
      "name": "Examples",
      "description": "Sample operations scaffolded with the project; delete once you have real routes."
    }
  ],
  "components": {
    "securitySchemes": {
      "schemavaults-access-token": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access token issued by the auth server for this API server.",
        "x-schemavaults-title": "Access token (Bearer)",
        "x-schemavaults-challenge": "Bearer realm=\"schemavaults\""
      },
      "schemavaults-access-token-cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token_xxx_api_server_id_xxx",
        "description": "First-party access token cookie set after login.",
        "x-schemavaults-title": "Access token (cookie)"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Server time when the check ran (ISO 8601).",
            "example": "2025-01-01T00:00:00.000Z"
          }
        },
        "required": [
          "status",
          "timestamp"
        ]
      },
      "OperationError": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "string",
            "description": "Machine readable error code.",
            "example": "validation_error"
          },
          "message": {
            "type": "string",
            "description": "Human readable explanation.",
            "example": "Invalid request body"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OperationValidationIssue"
            },
            "description": "Present on `validation_error` responses."
          },
          "details": {
            "type": "object",
            "additionalProperties": {},
            "description": "Extra machine readable details (e.g. the missing scopes on `insufficient_scope`)."
          }
        },
        "required": [
          "success",
          "error",
          "message"
        ]
      },
      "OperationValidationIssue": {
        "type": "object",
        "properties": {
          "location": {
            "type": "string",
            "enum": [
              "params",
              "query",
              "headers",
              "body"
            ],
            "description": "Which part of the request failed validation."
          },
          "path": {
            "type": "string",
            "description": "Dotted path of the offending field within that part (empty for the whole part).",
            "example": "name"
          },
          "message": {
            "type": "string",
            "example": "Invalid input: expected string, received undefined"
          },
          "code": {
            "type": "string",
            "description": "zod issue code.",
            "example": "invalid_type"
          }
        },
        "required": [
          "location",
          "path",
          "message",
          "code"
        ]
      },
      "Greeting": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Hello, Ada!"
          },
          "name": {
            "type": "string",
            "example": "Ada"
          }
        },
        "required": [
          "message",
          "name"
        ]
      },
      "CreateGreetingRequest": {
        "type": "object",
        "properties": {
          "greeting": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "example": "Good morning"
          },
          "punctuation": {
            "type": "string",
            "enum": [
              "!",
              ".",
              "?"
            ],
            "default": "!"
          }
        },
        "required": [
          "greeting"
        ]
      },
      "CurrentUser": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string",
            "example": "8d5d3a9e-6d2f-4d7e-9c1b-2f6a1d0e4b3c"
          },
          "email": {
            "type": "string",
            "example": "ada@example.com"
          },
          "display_name": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "admin": {
            "type": "boolean",
            "description": "Whether the user is a platform administrator."
          }
        },
        "required": [
          "uid",
          "email",
          "admin"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check",
        "description": "Liveness probe for load balancers and uptime monitors.",
        "tags": [
          "System"
        ],
        "security": [],
        "x-schemavaults-auth": {
          "public": true,
          "schemes": [],
          "routeGuard": null,
          "requiredScopes": [],
          "organization": null
        },
        "responses": {
          "200": {
            "description": "The service is up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/greet/{name}": {
      "get": {
        "operationId": "getGreeting",
        "summary": "Greet someone",
        "description": "Builds a greeting from a path parameter and optional query parameters.",
        "tags": [
          "Examples"
        ],
        "security": [],
        "x-schemavaults-auth": {
          "public": true,
          "schemes": [],
          "routeGuard": null,
          "requiredScopes": [],
          "organization": null
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Who to greet.",
              "example": "Ada"
            },
            "required": true,
            "description": "Who to greet.",
            "name": "name",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "default": "Hello",
              "description": "The salutation to use.",
              "example": "Howdy"
            },
            "required": false,
            "description": "The salutation to use.",
            "name": "greeting",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "false",
              "description": "Upper-case the whole message."
            },
            "required": false,
            "description": "Upper-case the whole message.",
            "name": "shout",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "The greeting.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Greeting"
                }
              }
            }
          },
          "400": {
            "description": "The path parameters, query string, headers or body failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createGreeting",
        "summary": "Greet someone with a custom salutation",
        "tags": [
          "Examples"
        ],
        "security": [],
        "x-schemavaults-auth": {
          "public": true,
          "schemes": [],
          "routeGuard": null,
          "requiredScopes": [],
          "organization": null
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Who to greet.",
              "example": "Ada"
            },
            "required": true,
            "description": "Who to greet.",
            "name": "name",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "description": "How to greet the named person.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGreetingRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The greeting.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Greeting"
                }
              }
            }
          },
          "400": {
            "description": "The path parameters, query string, headers or body failed validation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationError"
                }
              }
            }
          },
          "415": {
            "description": "The request body is not `application/json`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getCurrentUser",
        "summary": "Get the authenticated user",
        "tags": [
          "Account"
        ],
        "security": [
          {
            "schemavaults-access-token": []
          },
          {
            "schemavaults-access-token-cookie": []
          }
        ],
        "x-schemavaults-auth": {
          "public": false,
          "schemes": [
            "schemavaults-access-token",
            "schemavaults-access-token-cookie"
          ],
          "routeGuard": "authenticated",
          "requiredScopes": [],
          "organization": null
        },
        "responses": {
          "200": {
            "description": "The caller's profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "401": {
            "description": "No credential was presented, or the presented credential is invalid, expired or revoked.",
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "description": "Challenge for the accepted schemes, e.g. `Bearer realm=\"schemavaults\"`."
                },
                "required": false,
                "description": "Challenge for the accepted schemes, e.g. `Bearer realm=\"schemavaults\"`."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationError"
                }
              }
            }
          }
        }
      }
    }
  },
